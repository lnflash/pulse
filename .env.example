# ============================================================
# Pulse v5 — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# ------------------------------------
# Core
# ------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ------------------------------------
# Anthropic / Claude
# ------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-5

# ------------------------------------
# Google / Gemini (fast tier)
# ------------------------------------
GOOGLE_AI_API_KEY=AIza...
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------
# Flash API
# ------------------------------------
FLASH_API_URL=https://api.flashapp.me
FLASH_API_TIMEOUT_MS=10000

# ------------------------------------
# WhatsApp Cloud API
# ------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-verify-token-here
WHATSAPP_API_VERSION=v18.0

# ------------------------------------
# Redis (context store)
# ------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=pulse:v5:
CONTEXT_TTL_SECONDS=86400

# ------------------------------------
# ElevenLabs (voice synthesis)
# ------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=

# ------------------------------------
# OpenAI (Whisper STT)
# ------------------------------------
OPENAI_API_KEY=

# ------------------------------------
# Security
# ------------------------------------
API_KEY=change-me-in-production
JWT_SECRET=change-me-in-production
ADMIN_TOKEN=change-me-in-production

# ------------------------------------
# Storage paths
# ------------------------------------
STORAGE_ROOT_DIR=./data/storage
CONTEXT_DATA_DIR=./data/contexts

# ------------------------------------
# Feature flags
# ------------------------------------
ENABLE_VOICE=false
ENABLE_MERCHANT_TOOLS=false
ENABLE_DISCOVERY=false
SANDBOX_MODE=false
