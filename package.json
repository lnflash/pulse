{
  "name": "pulse",
  "version": "5.0.0",
  "description": "Pulse v5 — Agent-native financial assistant for Flash wallet users",
  "type": "module",
  "main": "dist/index.js",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json && cp -r src/prompts dist/prompts",
    "build:watch": "tsc --project tsconfig.json --watch",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "NODE_ENV=test jest --config jest.config.ts",
    "test:watch": "NODE_ENV=test jest --config jest.config.ts --watch",
    "test:cov": "NODE_ENV=test jest --config jest.config.ts --coverage",
    "test:ci": "NODE_ENV=test jest --config jest.config.ts --coverage --ci --bail"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "ioredis": "^5.9.3",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "uuid": "^11.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.11",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "jest": "^29.7.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lnflash/pulse.git"
  },
  "keywords": [],
  "author": "",
  "bugs": {
    "url": "https://github.com/lnflash/pulse/issues"
  },
  "homepage": "https://github.com/lnflash/pulse#readme"
}
