# ============================================
# Pulse Production Configuration
# ============================================
# Copy this file to .env.production and fill in the values

# Application Configuration
NODE_ENV=production
PORT=3000
LOG_LEVEL=error

# ============================================
# Redis Configuration (Required)
# ============================================
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=your-secure-redis-password
REDIS_DB=0

# Redis Connection Pool (Optional)
REDIS_POOL_ENABLED=true
REDIS_POOL_MIN=2
REDIS_POOL_MAX=10
REDIS_POOL_ACQUIRE_TIMEOUT=3000
REDIS_POOL_IDLE_TIMEOUT=30000
REDIS_POOL_CONNECTION_NAME=pulse-pool
REDIS_ENABLE_READ_REPLICAS=false

# ============================================
# RabbitMQ Configuration (Required for Multi-Process)
# ============================================
RABBITMQ_URL=amqp://user:password@your-rabbitmq-host:5672
RABBITMQ_QUEUE_NAME=flash_whatsapp_events

# ============================================
# Flash API Configuration (Required)
# ============================================
FLASH_API_URL=https://api.flashapp.me/graphql
FLASH_API_KEY=your-production-api-key
FLASH_API_SECRET=your-production-api-secret

# ============================================
# Google Gemini AI Configuration (Required)
# ============================================
GEMINI_API_KEY=your-gemini-api-key

# ============================================
# ElevenLabs TTS Configuration (Optional)
# ============================================
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_VOICE_ID2=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_VOICE_ID3=EXAVITQu4vr4xnSDxMaL

# ============================================
# Security Configuration (REQUIRED)
# ============================================
# Generate secure random strings for production
# Use: openssl rand -hex 32
JWT_SECRET=generate-secure-jwt-secret-min-32-chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

ENCRYPTION_KEY=generate-secure-encryption-key-min-32-chars
ENCRYPTION_SALT=generate-secure-salt-min-16-chars
HASH_SALT=generate-secure-hash-salt-min-16-chars

SESSION_SECRET=generate-secure-session-secret-min-32-chars
SESSION_EXPIRES_IN=86400
SESSION_ROTATION_INTERVAL=3600

WEBHOOK_SECRET=generate-secure-webhook-secret-min-32-chars
WEBHOOK_TOLERANCE=300

# MFA/OTP Configuration
OTP_LENGTH=6
OTP_EXPIRES_IN=300
OTP_MAX_ATTEMPTS=3
MFA_TIMEOUT_SECONDS=300

# ============================================
# CORS Configuration
# ============================================
# Specify exact origins for production
CORS_ALLOWED_ORIGINS=https://app.flashapp.me,https://admin.flashapp.me

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# Request Size Limits
# ============================================
MAX_REQUEST_SIZE=10mb
MAX_JSON_SIZE=1mb
MAX_URL_ENCODED_SIZE=1mb

# ============================================
# Nostr Configuration (Optional)
# ============================================
NOSTR_PRIVATE_KEY=
NOSTR_RELAYS=wss://relay.damus.io,wss://relay.nostr.band,wss://relay.flashapp.me
NOSTR_PULSE_NPUB=

# ============================================
# Admin Configuration
# ============================================
# Production admin phone numbers
ADMIN_PHONE_NUMBERS=your-admin-phone-numbers

# ============================================
# Support Configuration
# ============================================
SUPPORT_PHONE_NUMBER=your-support-phone-number

# ============================================
# Google Cloud Services (Required for Voice)
# ============================================
# Path to service account JSON key file
GOOGLE_CLOUD_KEYFILE=/path/to/production-service-account.json

# ============================================
# WhatsApp Configuration
# ============================================

# WhatsApp Cloud API (Recommended for Production)
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_APP_SECRET=your-app-secret
WHATSAPP_WEBHOOK_URL=https://your-domain.com/whatsapp/webhook

# WhatsApp Web Multi-Instance (Legacy/Alternative)
# Format: [{"phoneNumber":"1234567890","enabled":true}] or comma-separated list
WHATSAPP_INSTANCES=
WHATSAPP_DEFAULT_PHONE=
WHATSAPP_SESSION_PATH=/app/whatsapp-sessions
WHATSAPP_AUTO_RECONNECT=true
WHATSAPP_MAX_RECONNECT_ATTEMPTS=10
CHROME_DEBUG_PORT_START=9222

# ============================================
# Caching & Performance
# ============================================
BALANCE_CACHE_TTL=300
PRICE_CACHE_TTL=900
USERNAME_CACHE_TTL=3600
EXCHANGE_RATE_CACHE_TTL=1800
TRANSACTION_CACHE_TTL=86400
SESSION_CACHE_TTL=1800

# Cache Warming
CACHE_WARMUP_ENABLED=true
CACHE_WARMUP_ON_STARTUP=true
CACHE_WARMUP_SCHEDULE=0 * * * *
CACHE_WARMUP_CURRENCIES=USD,JMD
CACHE_WARMUP_PRICE=true
CACHE_WARMUP_SESSION=true

# ============================================
# Notifications
# ============================================
ENABLE_WEBSOCKET_NOTIFICATIONS=true
ENABLE_INTRALEDGER_POLLING=true
PAYMENT_POLLING_INTERVAL=10000

# ============================================
# Monitoring & Alerting (Optional)
# ============================================
# OpenTelemetry Configuration
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=pulse-production
OTEL_SERVICE_VERSION=1.9.9

# Sentry Configuration (Optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ============================================
# Performance Tuning
# ============================================
# Message processing
MESSAGE_PROCESSING_CONCURRENCY=10
MESSAGE_PROCESSING_TIMEOUT=30000

# Cache settings
CACHE_TTL=3600
CACHE_MAX_ITEMS=1000

# ============================================
# Feature Flags
# ============================================
# Enable/disable features for production
ENABLE_VOICE_NOTES=true
ENABLE_AI_RESPONSES=true
ENABLE_PAYMENT_CONFIRMATIONS=true
ENABLE_METRICS=true
ENABLE_HEALTH_CHECK=true